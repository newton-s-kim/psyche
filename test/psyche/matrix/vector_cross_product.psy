var a = Vector(4,-2,5);
var b = Vector(3,1,-1);

print Vector.cross(a, b); // expect: -3.000000
// expect: 19.000000
// expect: 10.000000

print Vector.cross(a, b) == Vector.cross(-b, a); // expect: true

var p1 = Vector(1,1,1);
var p2 = Vector(2,3,4);
var p3 = Vector(3,0,-1);
print Vector.cross(p2-p1, p3-p2); // expect: -1.000000
// expect: 8.000000
// expect: -5.000000


