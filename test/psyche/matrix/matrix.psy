include "algebra";

var a = Matrix(1,2,3,nil,
		0,5,-6);
var b = Matrix(9,7,0,8,nil,
		0.5,-2,6,1,nil,
		0,0,-1,6,nil,
		5,1.7,3.14,-4);

print a; // expect: 1.000000 2.000000 3.000000
// expect: 0.000000 5.000000 -6.000000
print b; // expect: 9.000000 7.000000 0.000000 8.000000
// expect: 0.500000 -2.000000 6.000000 1.000000
// expect: 0.000000 0.000000 -1.000000 6.000000
// expect: 5.000000 1.700000 3.140000 -4.000000

a = Matrix(1,2,nil,
	3,4);
b = Matrix(1,2,nil,
	4,3);
print a == b; // expect: false

a = Matrix(2,-1,3,nil,
	0,4,6,nil,
	-6,10,-5);
b = Matrix(4,7,-8,nil,
	9,3,5,nil,
	1,-1,2);
print a+b; // expect: 6.000000 6.000000 -5.000000
// expect: 9.000000 7.000000 11.000000
// expect: -5.000000 9.000000 -3.000000

a = Matrix(2,-3,nil,
	4,-1,nil,
	0.5,6);
print 5*a; // expect: 10.000000 -15.000000
// expect: 20.000000 -5.000000
// expect: 2.500000 30.000000

a = Matrix(4,7,nil,
	3,5);
b = Matrix(9,-2,nil,
	6,8);
print a*b; // expect: 78.000000 48.000000
// expect: 57.000000 34.000000

a = Matrix(5,8,nil,
	1,0,nil,
	2,7);
b = Matrix(-4,-3,nil,
	2,0);
print a*b; // expect: -4.000000 -15.000000
// expect: -4.000000 -3.000000
// expect: 6.000000 -6.000000

a = Matrix(3,2,-1,nil,
	6,5,2,nil,
2,1,4);
print a.transpose(); // expect: 3.000000 6.000000 2.000000
// expect: 2.000000 5.000000 1.000000
// expect: -1.000000 2.000000 4.000000

a = Vector(5,0,3);
print a.transpose(); // expect: 5.000000 0.000000 3.000000
