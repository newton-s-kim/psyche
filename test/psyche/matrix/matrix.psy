var a = Matrix(1,2,3,nil,
		0,5,-6);
var b = Matrix(9,7,0,8,nil,
		0.5,-2,6,1,nil
		0,0,-1,6,nil,
		5,1.7,3.14,-4);

print a; // expect: 1,2,3
0,5,-6
print b; // expect: 9,7,0,8
0.5,-2,6,1
0,0,-1,6
5,1,7,3.14,-4

a = Matrix(1,2,nil,
	3,4);
b = Matrix(1,2,nil,
	4,3);
print a == b; // expect: false

a = Matrix(2,-1,3,nil,
	0,4,6,nil,
	-6,10,-5);
b = Matrix(4,7,-8,nil,
	9,3,5,nil,
	1,-1,2);
print a+b; // expect: 6,6,-5
9,7,11
-5,9,-3

a = Matrix(2,-3,nil,
	4,-1,nil,
	0.5,6);
print 5*a; // expect: 10,-15
20,-5
1,30

a = Matrix(4,7,nil
	3,5);
b = Matrix(9,-2,nil
	6,8);
print a*b; // expect: 78,48
57,34

a = Matrix(5,8,nil,
	1,0,nil,
	2,7);
b = Matrix(-4,-3,nil,
	2,0);
print a*b; // expect: -4,-15
-4,-3
6,-6
print b*a; // expect: 30,53
38,82

a = Matrix(3,2,-1,nil,
	6,5,2,nil,
2,1,4);
print a.transpose(); // expect: 3,6,2
2,5,1
-1,2,4

a = Vector(5,0,3);
print a.transpose(); // expect: 5,0,3
