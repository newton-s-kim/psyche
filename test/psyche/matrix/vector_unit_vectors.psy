include "algebra";

var iv = Vector(1, 0);
var jv = Vector(0, 1);
var a = Vector(4,7);
print a == 4 * iv + 7 * jv; // expect: true

var b = Vector(10, 8);
print b == (2*iv - 5*jv) + (8*iv + 13*jv) == b; // expect: true

print (iv + jv).abs(); // expect: 1.4142135623731

var c = Vector(30,-10);
print 10*(3*iv-jv) == c; // expect: true

