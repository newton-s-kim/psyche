include "math";
var a = Vector(10, 2, -6);
var b = Vector(-0.5, 4, -3);
print Vector.dot(a, b); // expect: 21

a = Vector(-3, -1, 4);
b = Vector(2, 14, 5);
print Vector.dot(a, b); // expect: 0

a = Vector(2, 3, 1);
b = Vector(-1, 5, 1);
print acos(Vector.dot(a, b) / (a.abs() * b.abs())); // expect: 0.7668754084914

a = Vector(2, 5, 4);
print acos(2 / a.abs()); // expect: 1.2680503751719
print acos(5 / a.abs()); // expect: 0.72972765622697
print acos(4 / a.abs()); // expect: 0.93193118255949

a = Vector(2, 3, -4);
b = Vector(1, 1, 2);
print a.component(b); // expect: -1.2247448713916

a = Vector(4, 1);
b = Vector(2, 3);
print a.project(b); // expect: 1.692308
// expect: 2.538462

a = Vector(3, -1, 5);
b = Vector(2, 1, 2);
print a.project(b); // expect: 3.333333
// expect: 1.666667
// expect: 3.333333
print a - a.project(b); // expect: -0.333333
// expect: -2.666667
// expect: 1.666667

a = Vector(10,2,-6);
b = Vector(-0.5,4,-3);
print Vector.dot(a, b); // expect: 21

var i = Vector(1, 0);
var j = Vector(0, 1);
print Vector.dot(i, j); // expect: 0
