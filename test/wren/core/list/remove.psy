var a = [1, 2, 3]
a.remove(2)
print a; // expect: [1, 3]

var b = [1, 2, 3]
b.remove(1)
print b; // expect: [2, 3]

var c = [1, 2, 3]
c.remove(3)
print c; // expect: [1, 2]

// Return the removed value.
print [3, 4, 5].remove(4); // expect: 4
print [3, 4, 5].remove(5); // expect: 5

// Return null when not found
print [1, 2, 3].remove(8); // expect: null
