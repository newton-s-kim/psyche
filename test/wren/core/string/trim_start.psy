print "".trimStart() == "" // expect: true
print "foo".trimStart() == "foo" // expect: true
print " \t\r\nfoo b\tar \t\r\n".trimStart() == "foo b\tar \t\r\n" // expect: true
print " \t\r\n \t\r\n".trimStart() == "" // expect: true
print " \n\n\tsøméஃthîng".trimStart() == "søméஃthîng" // expect: true

print "".trimStart("abc") == "" // expect: true
print "foo".trimStart("abc") == "foo" // expect: true
print "foo".trimStart("") == "foo" // expect: true
print "cbacbfoobarab".trimStart("abc") == "foobarab" // expect: true
print "abcbacba".trimStart("abc") == "" // expect: true
print "søméஃthîng".trimStart("ஃmésø") == "thîng" // expect: true

// 8-bit clean.
print " \t\ra\0b".trimStart() == "a\0b" // expect: true
print "\0a\0b\0c\0".trimStart("a\0") == "b\0c\0" // expect: true
