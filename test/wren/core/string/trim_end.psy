print "".trimEnd() == "" // expect: true
print "foo".trimEnd() == "foo" // expect: true
print " \t\r\nfoo b\tar \t\r\n".trimEnd() == " \t\r\nfoo b\tar" // expect: true
print " \t\r\n \t\r\n".trimEnd() == "" // expect: true
print "søméஃthîng \n\n\t".trimEnd() == "søméஃthîng" // expect: true

print "".trimEnd("abc") == "" // expect: true
print "foo".trimEnd("abc") == "foo" // expect: true
print "foo".trimEnd("") == "foo" // expect: true
print "cbacbfoobarab".trimEnd("abc") == "cbacbfoobar" // expect: true
print "abcbacba".trimEnd("abc") == "" // expect: true
print "søméஃthîngsøméஃ".trimEnd("ஃmésø") == "søméஃthîng" // expect: true

// 8-bit clean.
print " \t\ra\0b \t\r".trimEnd() == " \t\ra\0b" // expect: true
print "\0a\0b\0c\0".trimEnd("c\0") == "\0a\0b" // expect: true
