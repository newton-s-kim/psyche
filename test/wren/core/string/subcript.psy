// Returns characters (as strings).
print "abcd"[0]; // expect: a
print "abcd"[1]; // expect: b
print "abcd"[2]; // expect: c
print "abcd"[3]; // expect: d

// Allows indexing backwards from the end.
print "abcd"[-4]; // expect: a
print "abcd"[-3]; // expect: b
print "abcd"[-2]; // expect: c
print "abcd"[-1]; // expect: d

// Regression: Make sure the string's internal buffer size is correct.
print "abcd"[1] == "b"; // expect: true

// Indexes by byte, not code point.
//
// Bytes:           11111
//        012345678901234
// Chars: sø mé ஃ  thî ng
print "søméஃthîng"[0]; // expect: s
print "søméஃthîng"[1]; // expect: ø
print "søméஃthîng"[3]; // expect: m
print "søméஃthîng"[6]; // expect: ஃ
print "søméஃthîng"[10]; // expect: h
print "søméஃthîng"[-1]; // expect: g
print "søméஃthîng"[-2]; // expect: n
print "søméஃthîng"[-4]; // expect: î

// If the subscript is in the middle of a UTF-8 sequence, return the raw byte.
print "søméஃthîng"[2] == "\xb8"; // expect: true
print "søméஃthîng"[7] == "\xae"; // expect: true
print "søméஃthîng"[8] == "\x83"; // expect: true
print "søméஃ"[-1] == "\x83"; // expect: true
print "søméஃ"[-2] == "\xae"; // expect: true

// 8-bit clean.
print "a\0b\0c"[0] == "a"; // expect: true
print "a\0b\0c"[1] == "\0"; // expect: true
print "a\0b\0c"[2] == "b"; // expect: true
print "a\0b\0c"[3] == "\0"; // expect: true
print "a\0b\0c"[4] == "c"; // expect: true

// Returns single byte strings for invalid UTF-8 sequences.
print "\xef\xf7"[0] == "\xef"; // expect: true
print "\xef\xf7"[1] == "\xf7"; // expect: true
