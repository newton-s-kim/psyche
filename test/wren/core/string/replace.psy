print "something".replace("some", "no"); // expect: nothing
print "something".replace("thing", "one"); // expect: someone
print "something".replace("ometh", "umm"))  // expect: summing
print "something".replace("math", "ton"); // expect: something

// Multiple.
print "somethingsomething".replace("some", "no"); // expect: nothingnothing
print "abc abc abc".replace(" ", ""); // expect: abcabcabc
print "abcabcabc".replace("abc", ""); // expect: 

// Non-ASCII.
print "søméthîng".replace("sømé", "nø");  // expect: nøthîng
print "søméthîng".replace("meth", "ton"); // expect: søméthîng

// 8-bit clean.
print "a\0b\0c".replace("\0", ""); // expect: abc
print "a\0b\0c".replace("b", "") == "a\0\0c"; // expect: true
