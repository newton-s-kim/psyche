BUILD_DIR=@__build_dir__@
PROGRAMME=psyche

all:
	$(MAKE) -C byte-code $@ -j`nproc`
	$(MAKE) -C libs/math $@ -j`nproc`
	$(MAKE) -C pcsa $@ -j`nproc`
	$(MAKE) -C psyche $@ -j`nproc`

clean:
	$(MAKE) -C byte-code $@ -j`nproc`
	$(MAKE) -C libs/math $@ -j`nproc`
	$(MAKE) -C pcsa $@ -j`nproc`
	$(MAKE) -C psyche $@ -j`nproc`

run:
	$(BUILD_DIR)/$(PROGRAMME)

tc:
	./tool/run-test.py

bm:
	./tool/benchmark.py > benchmark-`git branch --show-current`-`date +%y%m%d-%H%M%S`.txt

prof:
	for f in `find test/wren/benchmark/ -name "*.psy"`; do ./profile.sh $$f; done

distclean: clean
	rm -rf $(BUILD_DIR)
	rm byte-code/src/common.h
	rm Makefile byte-code/Makefile libs/math/Makefile pcsa/Makefile psyche/Makefile
	find test -name "*.gmon" -exec rm {} \;
	find test -name "*.png" -exec rm {} \;

